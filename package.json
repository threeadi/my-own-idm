{
  "name": "IDM Turbo Desktop",
  "version": "0.1.0-dev",
  "description": "A High-Performance Desktop Internet Download Manager built with Tauri v2, Rust, Svelte 5 (Runes).",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:backend:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lib --summary-only",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@lucide/svelte": "^1.47.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "lucide-svelte": "^1.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@vitest/coverage-v8": "^5.0.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}